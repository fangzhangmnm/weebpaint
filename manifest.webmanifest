{
  "name": "WeebPaint",
  "short_name": "WeebPaint",
  "description": "A free, open-source drawing app for anime and illustration. Runs in your browser. No account, no install — and a cloud-synced gallery you control.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#f6f4ef",
  "theme_color": "#f6f4ef",
  "lang": "en",
  "file_handlers": [
    { "action": "./", "accept": { "image/openraster": [".ora"] } }
  ],
  "icons": [
    { "src": "./icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "./icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "./icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "./icon.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" }
  ]
}
